if SHIELD_SOFLE_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "Sofle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Sofle has two peripheral halves (left + right)
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS (2) + desired BT profiles (2). The
# controller reserves RAM and radio scheduling slots per configured connection
# rather than per active one, so keep this only as large as it needs to be: the
# dongle is USB powered and rarely needs more than a couple of host profiles.
config BT_MAX_CONN
    default 4

# Set this to the same number as BT_MAX_CONN. ZMK_BLE_PROFILE_COUNT is derived
# as BT_MAX_PAIRED - ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS, so this leaves profiles
# 0 and 1; &bt BT_SEL 2 and above become no-ops.
config BT_MAX_PAIRED
    default 4

# 128x32 SSD1306 OLED on the XIAO I2C pins, driven by the custom status screen
# in custom_status_screen.c (per side battery + active layer + WPM).
if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# The layer and WPM widgets on the status screen are custom, so the built in
# ones stay off; this only enables the WPM tracking they read from.
config ZMK_WPM
    default y

config LV_Z_MEM_POOL_SIZE
    default 4096

# ZMK implies LV_CONF_MINIMAL, which leaves the label widget out unless a widget
# selects it. The built in ones do, but every widget here is custom, so the
# status screen has to ask for it itself.
config LV_USE_LABEL
    default y

config LV_FONT_MONTSERRAT_12
    default y

config LV_FONT_MONTSERRAT_14
    default y

config LV_USE_THEME_MONO
    default y if LV_Z_BITS_PER_PIXEL=1

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
